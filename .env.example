# ============================================================
# PROVIA - Environment Variables
# Copy this file to .env and fill in all values before running
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d --build
#
# IMPORTANT: Never commit .env to git — it contains secrets.
# ============================================================

# ----------------------------------------------------------
# PostgreSQL Database
# These are used by both the 'db' container and the 'app' container
# ----------------------------------------------------------
PGHOST=db
PGPORT=5432
PGDATABASE=provia
PGUSER=provia_user
PGPASSWORD=change_this_strong_password_here

# ----------------------------------------------------------
# Authentication
# Generate a strong random key (min 32 chars):
#   openssl rand -base64 48
# ----------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_random_64_char_string_minimum

# ----------------------------------------------------------
# CORS — Allowed frontend origins
# Set to your actual domain(s) in production (comma-separated)
# ----------------------------------------------------------
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ----------------------------------------------------------
# Email — SendGrid
# Get your API key at: https://app.sendgrid.com/settings/api_keys
# ----------------------------------------------------------
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# ----------------------------------------------------------
# SMS — Twilio
# Get credentials at: https://console.twilio.com
# ----------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ----------------------------------------------------------
# AI / OpenAI (optional — used for AI assistant features)
# Get your key at: https://platform.openai.com/api-keys
# ----------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here

# ----------------------------------------------------------
# Google Maps / Places API (optional — used for address lookup)
# Get your key at: https://console.cloud.google.com
# ----------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# ----------------------------------------------------------
# WhatsApp via 360Dialog (optional — used for WhatsApp messaging)
# Get credentials at: https://www.360dialog.com
# ----------------------------------------------------------
DIALOG360_API_KEY=your_360dialog_api_key_here
DIALOG360_PHONE_NUMBER=+1XXXXXXXXXX

# ----------------------------------------------------------
# ASP.NET Core runtime environment
# Use 'Production' on your server; 'Development' on Replit
# ----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
