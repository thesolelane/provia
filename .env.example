# PROVIA Environment Variables
# Copy to .env and fill in real values before running docker compose up
# NEVER commit .env to git

# PostgreSQL
PGHOST=db
PGPORT=5432
PGDATABASE=provia
PGUSER=provia_user
PGPASSWORD=change_this_strong_password

# DATABASE_URL (full connection string — alternative to individual PG* vars)
DATABASE_URL=postgresql://provia_user:change_this_strong_password@db:5432/provia

# JWT Authentication (generate: openssl rand -base64 48)
JWT_SECRET_KEY=change_this_to_a_random_64_char_string

# CORS — your domain(s), comma-separated
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SendGrid (email)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# OpenAI (optional)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Maps (optional)
GOOGLE_API_KEY=your_google_api_key_here

# 360Dialog WhatsApp (optional)
DIALOG360_API_KEY=your_360dialog_api_key_here
DIALOG360_PHONE_NUMBER=+1XXXXXXXXXX

# Runtime
ASPNETCORE_ENVIRONMENT=Production
