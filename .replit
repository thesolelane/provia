modules = ["dotnet", "dotnet-7.0", "python-3.11", "nodejs-20", "dotnet-10.0", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["dotnet-sdk"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DotNetJobTrackerApp"

[[workflows.workflow]]
name = "DotNetJobTrackerApp"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd JobTracker && dotnet run --urls=http://0.0.0.0:5000"
waitForPort = 5000

[deployment]
run = ["sh", "-c", "cd JobTracker && dotnet run --urls=http://0.0.0.0:5000"]

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
integrations = ["sendgrid:1.0.0"]

[userenv]

[userenv.shared]
JWT_SECRET_KEY = "PROVIA-Production-SecureKey-MinimumLength-32Chars"
ALLOWED_ORIGINS = "http://localhost:3000,http://localhost:5000,http://0.0.0.0:5000"
