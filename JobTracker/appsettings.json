{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${PGHOST};Port=${PGPORT};Database=${PGDATABASE};Username=${PGUSER};Password=${PGPASSWORD}"
  },
  "OpenAI": {
    "APIKey": "${OPENAI_API_KEY}",
    "Model": "gpt-3.5-turbo",
    "Temperature": "0.7",
    "MaxTokens": "2000"
  }
}
